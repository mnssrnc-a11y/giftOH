APP_NAME="Gift of Hope"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_USER_PROVIDER=firebase

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Firebase (required) — https://console.firebase.google.com
#   Service account JSON: Project settings → Service accounts → Generate new private key.
#   Web config: Project settings → General → Your apps → Web app.
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json
FIREBASE_DATABASE_URL=https://githope-d36ee-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=githope-d36ee.firebaseapp.com
FIREBASE_CLIENT_DATABASE_URL=https://githope-d36ee-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=githope-d36ee
FIREBASE_STORAGE_BUCKET=githope-d36ee.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
USE_FIREBASE=true
DATA_DRIVER=firebase

SESSION_DRIVER=file
SESSION_LIFETIME=480
# Sign out when the browser closes unless "Remember me" was ticked.
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# AI provider cooldowns and daily counters are kept in the cache.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Email (verification codes and notices) — Brevo's HTTPS API, https://www.brevo.com
#   The super admin saves the Brevo API key (it starts with "xkeysib-") and the sender in
#   Superadmin → System settings → Verification email settings; it is stored encrypted in
#   Firebase. BREVO_API_KEY below is optional and, when set, wins over the saved key.
#   Gmail SMTP still works instead: MAIL_MAILER=smtp with MAIL_HOST=smtp.gmail.com and an App
#   Password in MAIL_PASSWORD. Without a password the app uses Brevo.
# Never commit a real key or password.
# ---------------------------------------------------------------------------
MAIL_MAILER=brevo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Funding process (from the foundation interview) — see config/funding.php
# ---------------------------------------------------------------------------
FUNDING_MIN_BENEFICIARIES=20
FUNDING_MAX_BENEFICIARIES=40
FUNDING_ASSESSMENT_DAYS=7
FUNDING_LIQUIDATION_DAYS=30
FUNDING_PER_PERSON_ALLOCATION=500
# Request files (IDs, certificates, receipts) are private; served only to the requester and staff.
FUNDING_FILES_DISK=local

# ---------------------------------------------------------------------------
# Anti-malware scanning of uploads — see config/security.php
# Every upload is scanned before it is stored; stored files are re-scanned daily at 02:30
# (php artisan security:scan-files --quarantine). Engines: heuristic (built in, always on),
# defender (Microsoft Defender, found automatically on Windows), clamav (a clamd daemon).
# ---------------------------------------------------------------------------
UPLOAD_SCAN_ENGINES=heuristic,defender
# true = refuse uploads when an antivirus engine is unavailable
UPLOAD_SCAN_FAIL_CLOSED=false
# DEFENDER_MPCMDRUN_PATH=
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# ---------------------------------------------------------------------------
# Monthly AI price update (php artisan prices:update) — see config/pricing.php
# Runs on the 1st of each month via the Laravel scheduler. Keep the scheduler running with
# `php artisan schedule:work`, or add a Windows Task Scheduler entry that runs
# `php artisan schedule:run` every minute.
# ---------------------------------------------------------------------------
PRICING_DTI_PAGE=https://www.dti.gov.ph/dti-consumer-space/dti-latest-srps-basic-necessities-prime-commodities
PRICING_TGP_SEARCH="https://tgp.com.ph/?s=%s&post_type=product"

# ---------------------------------------------------------------------------
# AI providers (optional, all have free tiers) — see config/ai.php
# Calls fail over to the next provider when one hits its rate/daily limit.
# Without any key, the system uses its rule-based recommendations.
#   Gemini      https://aistudio.google.com/apikey
#   Groq        https://console.groq.com/keys
#   OpenRouter  https://openrouter.ai/keys            (models ending in ":free")
# Check them with: php artisan ai:status --ping
# ---------------------------------------------------------------------------
AI_PROVIDER_ORDER=gemini,groq,openrouter
# failover = always try in order; round_robin = spread calls across providers
AI_STRATEGY=failover
AI_TIMEOUT=25
AI_CACHE_SECONDS=3600

GEMINI_API_KEY=''
AI_GEMINI_MODEL=gemini-flash-latest
# Web search for the monthly price update ("Grounding with Google Search"; the -latest alias follows Google's current Flash model).
AI_GEMINI_SEARCH_MODEL=gemini-flash-latest
AI_SEARCH_DAILY_LIMIT=400

GROQ_API_KEY=''
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_GROQ_DAILY_LIMIT=900

OPENROUTER_API_KEY=''
AI_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_OPENROUTER_DAILY_LIMIT=45

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Online deployment (Render free plan). See DEPLOY.md.
# Generate the real values with: php artisan deploy:render-env --brevo-key=...
# ---------------------------------------------------------------------------
# Keep uploads in the Firebase Realtime Database instead of storage/app (the
# free plan's disk is wiped on every restart). Leave "local" on your own PC.
FILES_DRIVER=local
# Optional: a Brevo API key here wins over the one the super admin saves (see Email above).
BREVO_API_KEY=
# The Firebase service-account JSON itself (raw or base64), for hosts without files.
FIREBASE_CREDENTIALS_JSON=
