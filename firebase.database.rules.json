{
  "rules": {
    ".read": false,
    ".write": false,

    "boxes": {
      ".read": true,
      "$boxId": {
        ".write": true
      }
    },
    "logs": {
      ".read": true,
      "$boxId": {
        ".write": true
      }
    },

    "users": { ".indexOn": ["email"] },
    "funding_requests": { ".indexOn": ["user_id", "status_id", "created_at"] },
    "funding_approvals": { ".indexOn": ["request_id", "approved_by"] },
    "funding_appeals": { ".indexOn": ["original_request_id"] },
    "donations": { ".indexOn": ["user_id", "iot_box_id", "created_at"] },
    "activity_logs": { ".indexOn": ["user_id", "created_at"] },
    "audit_logs": { ".indexOn": ["user_id", "subject_id", "created_at"] },
    "notifications": { ".indexOn": ["user_id", "created_at"] },
    "notification_history": { ".indexOn": ["user_id", "created_at", "read_at"] },
    "admin_posts": { ".indexOn": ["created_at"] },
    "request_messages": { ".indexOn": ["request_id", "created_at"] },
    "price_list": { "$group": { "items": { ".indexOn": ["type", "name"] } } }
  }
}
